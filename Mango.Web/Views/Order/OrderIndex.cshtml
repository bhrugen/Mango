<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 fade-in-up">
	<div>
		<div class="section-label"><span>Dashboard</span></div>
		<h2 class="section-title mb-0">Order List</h2>
	</div>
	<!-- Status Filter Tabs (the "active" class marks the selected tab) -->
	<div class="d-flex gap-2 flex-wrap mt-3 mt-md-0">
		<a href="#" class="category-chip active">
			<i class="bi bi-grid-3x3-gap"></i>All
		</a>
		<a href="#" class="category-chip">
			<i class="bi bi-check-circle"></i>Approved
		</a>
		<a href="#" class="category-chip">
			<i class="bi bi-bag-check"></i>Ready for Pickup
		</a>
		<a href="#" class="category-chip">
			<i class="bi bi-x-circle"></i>Cancelled
		</a>
	</div>
</div>

<div class="card fade-in-up">
	<div class="card-body p-4">
		<table id="tblData" class="table pt-3" style="width:100%">
			<thead>
				<tr>
					<th>ID</th>
					 <th>Email</th>
					<th>Name</th>
					<th>Phone</th>
					<th>Status</th>
					<th>Total</th>
					<th></th> 
				</tr>
			</thead>
		</table>
	</div>
</div>
@section Scripts{
	<script src="~/js/order.js" asp-append-version="true"></script>
}