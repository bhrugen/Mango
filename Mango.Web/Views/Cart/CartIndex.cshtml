@model CartDto

@if (Model.CartHeader != null && Model.CartDetails?.Count() > 0)
{
    <div class="py-2">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 fade-in-up">
            <div>
                <div class="section-label"><span>Your Order</span></div>
                <h2 class="section-title mb-0">
                    Cart &amp; Checkout
                    <span class="badge badge-gold ms-2" style="font-size:.85rem;vertical-align:middle;">
                        @Model.CartDetails.Count() dishes
                    </span>
                </h2>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-grid me-2"></i>Add More
            </a>
        </div>

        <div class="row g-4">

            <!-- LEFT: Cart items + Contact details -->
            <div class="col-lg-8">

                <!-- Order Items card -->
                <div class="card fade-in-up mb-4">
                    <div class="card-header bg-dark-restaurant d-flex justify-content-between align-items-center">
                        <span style="font-family:Georgia,serif;font-weight:700;color:var(--brand-light);font-size:1rem;">
                            <i class="bi bi-basket3 me-2"></i>Order Items
                        </span>
                        <div class="text-end">
                            <div style="font-family:Georgia,serif;font-weight:700;color:var(--brand-primary);font-size:1.2rem;">
                                @Model.CartHeader.CartTotal.ToString("c")
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">

                        @foreach (var item in Model.CartDetails)
                        {
                            <div class="cart-item">
                                <div class="row align-items-center g-3">
                                    <div class="col-3 col-md-2">
                                        <img src="@item.Product.ImageUrl" alt="Sample Dish"
                                        style="width:75px;height:75px;object-fit:cover;border-radius:var(--radius-md);box-shadow:var(--shadow-sm);" />
                                    </div>
                                    <div class="col-9 col-md-4">
                                        <div class="menu-card-category mb-0">@item.Product.CategoryName</div>
                                        <h6 style="font-family:Georgia,serif;font-weight:700;margin-bottom:.25rem;">
                                           @item.Product.Name
                                        </h6>
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="cartDetailsId" value="@item.CartDetailsId" />
                                            <button type="submit" class="btn btn-link p-0 text-danger"
                                            style="font-size:.8rem;text-decoration:none;">
                                                <i class="bi bi-x-circle me-1"></i>Remove
                                            </button>
                                        </form>
                                    </div>
                                    <div class="col-4 col-md-2 text-center">
                                        <div class="text-muted small mb-1">Unit Price</div>
                                        <div class="fw-semibold">@item.Product.Price.ToString("c")</div>
                                    </div>
                                    <div class="col-4 col-md-2 text-center">
                                        <div class="text-muted small mb-1">Qty</div>
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <form asp-action="UpdateCount" method="post" class="d-inline">
                                                <input type="hidden" name="cartDetailsId" value="@item.CartDetailsId" />
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="change" value="-1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-0"
                                                style="line-height:1.4;">&#8722;</button>
                                            </form>
                                            <span class="fw-semibold px-1">@item.Count</span>
                                            <form asp-action="UpdateCount" method="post" class="d-inline">
                                                <input type="hidden" name="cartDetailsId" value="@item.CartDetailsId" />
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="change" value="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-0"
                                                style="line-height:1.4;">+</button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="col-4 col-md-2 text-end">
                                        <div class="text-muted small mb-1">Subtotal</div>
                                        <div class="price-tag-sm">@string.Format("{0:c}", item.Product.Price * item.Count)</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Promo Code — inline strip -->
                <div class="fade-in-up px-1">
                    <form asp-action="ApplyCoupon" method="post">
                        <input type="hidden" asp-for="CartHeader.UserId" value="" />
                        <input type="hidden" asp-for="CartHeader.CartHeaderId" value="1" />
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent border-end-0"
                            style="border-color:var(--border-warm);">
                                <i class="bi bi-ticket-perforated" style="color:var(--brand-primary);"></i>
                            </span>
                            @if (!string.IsNullOrEmpty(Model.CartHeader.CouponCode))
                                {
                                    <input type="hidden" asp-for="CartHeader.CouponCode" value="" />
                                <input disabled value="@Model.CartHeader.CouponCode" class="form-control border-start-0"
                                       placeholder="Promo code"
                                       style="border-color:var(--border-warm);font-size:.85rem;" />
                                <button type="submit" class="btn btn-gold btn-sm px-3">Remove</button>
                                }
                                else{
                                <input asp-for="CartHeader.CouponCode" class="form-control border-start-0"
                            placeholder="Promo code"
                            style="border-color:var(--border-warm);font-size:.85rem;" />
                            <button type="submit" class="btn btn-gold btn-sm px-3">Apply</button>
                                }
                        </div>
                    </form>
                   
                </div>

            </div>

            <!-- RIGHT: Contact Details + Summary -->
            <div class="col-lg-4">
                <div style="position:sticky;top:20px;">
                    <!-- Order Summary -->
                    <div class="card mb-3 fade-in-up">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Sub Total</span>
                                <span class="fw-semibold">@((Model.CartHeader.CartTotal + Model.CartHeader.Discount).ToString("c"))</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span class="small"><i class="bi bi-tag-fill me-1"></i>Discount </span>
                                <span class="fw-semibold">@Model.CartHeader.Discount.ToString("c")</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between">
                                <span style="font-family:Georgia,serif;font-weight:700;">Total</span>
                                <span style="font-family:Georgia,serif;font-weight:700;color:var(--brand-primary);">
                                    @Model.CartHeader.CartTotal.ToString("c")
                                </span>
                            </div>
                        </div>
                    </div>

                    
                    <!-- Contact Details -->
                    <div class="card mb-3 fade-in-up">
                        <div class="card-header">
                            <span style="font-family:Georgia,serif;font-weight:700;font-size:1rem;color:var(--charcoal);">
                                <i class="bi bi-person-lines-fill me-2" style="color:var(--brand-primary);"></i>Contact Details
                            </span>
                        </div>
                        <div class="card-body">
                            <form action="/Cart/Checkout" method="post" id="checkoutForm">
                            
                                <div class="mb-3">
                                    <label class="form-label"><i class="bi bi-person me-1 text-gold"></i>Full Name</label>
                                    <input asp-for="Name" class="form-control" placeholder="Your full name" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"><i class="bi bi-envelope me-1 text-gold"></i>Email</label>
                                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="mb-0">
                                    <label class="form-label"><i class="bi bi-telephone me-1 text-gold"></i>Phone</label>
                                    <input asp-for="Phone" class="form-control" placeholder="+1 555 000 0000" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 fade-in-up">
                        <button type="submit" form="checkoutForm" class="btn btn-gold btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Confirm Order &mdash; @Model.CartHeader.CartTotal.ToString("c")
                        </button>
                        <form action="/Cart/EmailCart" method="post">
                            <input type="hidden" name="CartHeader.UserId" value="" />
                            <input type="hidden" name="CartHeader.CartHeaderId" value="1" />
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-envelope me-2"></i>Email Order
                            </button>
                        </form>
                    </div>

                    <!-- Trust badges -->
                    <div class="d-flex justify-content-center gap-3 mt-4 pt-3"
                    style="border-top:1px solid var(--border-warm);">
                        <div class="text-center">
                            <i class="bi bi-shield-lock-fill d-block mb-1" style="color:var(--brand-primary);font-size:1.25rem;"></i>
                            <span class="text-muted" style="font-size:.7rem;">Secure</span>
                        </div>
                        <div class="text-center">
                            <i class="bi bi-truck d-block mb-1" style="color:var(--brand-primary);font-size:1.25rem;"></i>
                            <span class="text-muted" style="font-size:.7rem;">Fast Delivery</span>
                        </div>
                        <div class="text-center">
                            <i class="bi bi-award-fill d-block mb-1" style="color:var(--brand-primary);font-size:1.25rem;"></i>
                            <span class="text-muted" style="font-size:.7rem;">Quality</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
}
else
{
    <div class="text-center py-5 fade-in-up">
        <i class="bi bi-cart-x" style="font-size:3rem;color:var(--brand-primary);"></i>
        <h3 class="mt-3">Your cart is empty</h3>
        <p class="text-muted">Looks like you haven't added any items to your cart yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-gold mt-2">
            <i class="bi bi-grid me-2"></i>Browse Menu
        </a>
    </div>

}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}